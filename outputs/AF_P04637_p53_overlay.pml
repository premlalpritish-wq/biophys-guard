# PyMOL Biophysical Risk Overlay generated by biophys-guard
reinitialize
load AF_P04637_p53_biophys_risk.pdb, design_risk
bg_color white
hide everything, design_risk
show cartoon, design_risk
set cartoon_fancy_helices, 1
set cartoon_smooth_loops, 1

# Continuous Blue (-99.99 stable core) -> White (0 neutral) -> Red (+99.99 hotspot) spectrum
spectrum b, blue_white_red, design_risk, minimum=-99.99, maximum=99.99

# Named biophysical risk selections
select aggregation_hotspots, design_risk and ((chain A and resi 10+12+13+14+19+22+23+25+26+27+31+32+34+35+36+43+44+45+50+53+54+63+64+66+67+70+71+72+73+74+75+76+77+78+79+80+82+83+84+85+86+87+88+89+91+92+93+103+114+128+129+152+153+188+201+212+225+243+276+289+299+300+301+308+309+323+327+328+330+338+341+344+348+350+369+383+384+385))
select stable_core, design_risk and ((chain A and resi 95+108+109+112+113+124+125+127+132+133+134+135+141+143+145+147+151+155+157+159+161+162+163+172+173+189+193+194+195+197+205+213+214+215+216+217+218+220+229+230+232+234+235+236+237+240+242+245+246+252+253+254+255+256+257+258+266+269+270+271+272+274+278+279+281+282+332))
select destabilized_sites, design_risk and ((chain A and resi 4+5+8+9+17+21+55+56+58+60+61+62+69+107+111+149+170+174+175+176+185+192+196+203+238+239+251+267+275+291+306+314+316+375+376+377+378+379+380+390))

color 0xdc2626, aggregation_hotspots
show sticks, aggregation_hotspots and not name N+CA+C+O
create hotspot_surface, aggregation_hotspots
show surface, hotspot_surface
color 0xdc2626, hotspot_surface
set transparency, 0.45, hotspot_surface

color 0x2563eb, stable_core
show sticks, stable_core and not name N+CA+C+O

color 0xf97316, destabilized_sites
show sticks, destabilized_sites and not name N+CA+C+O

deselect
orient design_risk
zoom design_risk, 4
