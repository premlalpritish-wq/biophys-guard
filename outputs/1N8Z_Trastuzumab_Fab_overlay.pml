# PyMOL Biophysical Risk Overlay generated by biophys-guard
reinitialize
load 1N8Z_Trastuzumab_Fab_biophys_risk.pdb, design_risk
bg_color white
hide everything, design_risk
show cartoon, design_risk
set cartoon_fancy_helices, 1
set cartoon_smooth_loops, 1

# Continuous Blue (-99.99 stable core) -> White (0 neutral) -> Red (+99.99 hotspot) spectrum
spectrum b, blue_white_red, design_risk, minimum=-99.99, maximum=99.99

# Named biophysical risk selections
select aggregation_hotspots, design_risk and ((chain A and resi 53+54+110+154+214) or (chain B and resi 57+104+115+177))
select stable_core, design_risk and ((chain A and resi 2+11+13+19+21+25+29+32+33+34+35+36+37+38+44+46+47+48+58+62+64+71+73+74+75+78+82+83+86+87+89+90+91+96+98+99+101+111+113+115+116+117+118+120+121+124+130+131+132+133+135+136+137+139+140+144+146+148+162+163+164+172+173+174+175+176+177+179+181+186+193+196+201+209) or (chain B and resi 2+4+10+11+12+16+20+24+27+29+34+35+36+37+38+39+45+47+48+51+53+60+61+64+68+70+72+78+79+80+81+83+86+90+92+94+95+97+106+107+108+110+113+116+117+118+126+128+129+131+133+137+143+144+145+146+148+149+150+152+153+157+159+161+170+171+173+175+184+185+186+187+188+189+191+195+196+201+204+205+209+218))
select destabilized_sites, design_risk and ((chain A and resi 1+3+4+6+8+23+27+30+39+51+66+77+81+84+88+102+104+106+108+129+134+150+151+152+158+166+189+190+191+192+194+198+207+208) or (chain B and resi 6+9+17+22+30+31+32+33+49+50+54+84+96+98+99+100+111+125+136+142+147+154+156+178+180+190+203+207+210+212+217))

color 0xdc2626, aggregation_hotspots
show sticks, aggregation_hotspots and not name N+CA+C+O
create hotspot_surface, aggregation_hotspots
show surface, hotspot_surface
color 0xdc2626, hotspot_surface
set transparency, 0.45, hotspot_surface

color 0x2563eb, stable_core
show sticks, stable_core and not name N+CA+C+O

color 0xf97316, destabilized_sites
show sticks, destabilized_sites and not name N+CA+C+O

deselect
orient design_risk
zoom design_risk, 4
