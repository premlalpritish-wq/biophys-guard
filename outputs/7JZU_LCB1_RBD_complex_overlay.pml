# PyMOL Biophysical Risk Overlay generated by biophys-guard
reinitialize
load 7JZU_LCB1_RBD_complex_biophys_risk.pdb, design_risk
bg_color white
hide everything, design_risk
show cartoon, design_risk
set cartoon_fancy_helices, 1
set cartoon_smooth_loops, 1

# Continuous Blue (-99.99 stable core) -> White (0 neutral) -> Red (+99.99 hotspot) spectrum
spectrum b, blue_white_red, design_risk, minimum=-99.99, maximum=99.99

# Named biophysical risk selections
select aggregation_hotspots, design_risk and ((chain A and resi 4+15) or (chain B and resi 335+362+390+391+445+468+486+503+517+521+525))
select stable_core, design_risk and ((chain A and resi 5+6+7+9+10+12+13+16+22+24+25+26+28+29+31+32+35+43+47+54) or (chain B and resi 338+341+342+348+358+363+365+368+374+377+379+382+387+392+395+397+400+401+402+404+406+407+409+410+412+416+418+419+421+422+423+425+429+431+432+433+434+435+436+438+447+448+453+454+455+456+457+461+472+475+476+487+489+491+493+495+496+497+498+504+507+508+509+510+511+512+513+515+524))
select destabilized_sites, design_risk and ((chain A and resi 3+17+45) or (chain B and resi 336+344+347+350+351+353+361+385+394+403+420+424+443+451+459+480+488+492+500+505+516+522))

color 0xdc2626, aggregation_hotspots
show sticks, aggregation_hotspots and not name N+CA+C+O
create hotspot_surface, aggregation_hotspots
show surface, hotspot_surface
color 0xdc2626, hotspot_surface
set transparency, 0.45, hotspot_surface

color 0x2563eb, stable_core
show sticks, stable_core and not name N+CA+C+O

color 0xf97316, destabilized_sites
show sticks, destabilized_sites and not name N+CA+C+O

deselect
orient design_risk
zoom design_risk, 4
