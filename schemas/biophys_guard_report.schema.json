{
  "$defs": {
    "BiophysGuardConfig": {
      "description": "Runtime parameters and literature-calibrated reference bounds for biophys-guard.",
      "properties": {
        "ph": {
          "default": 7.4,
          "description": "Solution pH for coupled pKa and electrostatic calculations.",
          "maximum": 14.0,
          "minimum": 0.0,
          "title": "Ph",
          "type": "number"
        },
        "sap_radius": {
          "default": 5.0,
          "description": "Chennamsetty SAP spatial cutoff radius (A).",
          "exclusiveMinimum": 1.0,
          "maximum": 20.0,
          "title": "Sap Radius",
          "type": "number"
        },
        "sap_macro_radius": {
          "default": 10.0,
          "description": "Macroscopic SAP neighborhood cutoff radius (A).",
          "exclusiveMinimum": 2.0,
          "maximum": 25.0,
          "title": "Sap Macro Radius",
          "type": "number"
        },
        "scm_radius": {
          "default": 10.0,
          "description": "Agrawal et al. (2016) Spatial Charge Map cutoff radius (A).",
          "exclusiveMinimum": 2.0,
          "maximum": 25.0,
          "title": "Scm Radius",
          "type": "number"
        },
        "probe_radius": {
          "default": 1.4,
          "description": "Solvent probe radius for Shrake-Rupley SASA (A).",
          "exclusiveMinimum": 0.1,
          "maximum": 5.0,
          "title": "Probe Radius",
          "type": "number"
        },
        "n_sphere_points": {
          "default": 590,
          "description": "Fibonacci sphere tessellation points per atom for rotationally converged SASA.",
          "maximum": 1200,
          "minimum": 128,
          "title": "N Sphere Points",
          "type": "integer"
        },
        "sap_hotspot_threshold": {
          "default": 0.15,
          "description": "Per-residue Chennamsetty SAP threshold for flagging exposed aggregation hot-spots.",
          "title": "Sap Hotspot Threshold",
          "type": "number"
        },
        "rsasa_core_threshold": {
          "default": 0.18,
          "description": "Relative side-chain SASA cutoff below which a residue is considered buried core.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rsasa Core Threshold",
          "type": "number"
        },
        "coventry_sap_green_max": {
          "default": 25.0,
          "description": "Coventry SapScoreMetric green bound (sum of positive residue SAP).",
          "title": "Coventry Sap Green Max",
          "type": "number"
        },
        "coventry_sap_amber_max": {
          "default": 35.0,
          "description": "Coventry SapScoreMetric amber upper bound (Cao et al., Nature 2022).",
          "title": "Coventry Sap Amber Max",
          "type": "number"
        },
        "min_charge_symmetry_amber": {
          "default": 0.55,
          "description": "Single-chain charge symmetry amber lower bound.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Charge Symmetry Amber",
          "type": "number"
        },
        "min_charge_symmetry_red": {
          "default": 0.35,
          "description": "Single-chain charge symmetry red lower bound.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Charge Symmetry Red",
          "type": "number"
        },
        "stability_backend": {
          "default": "auto",
          "description": "Variant/stability scorer backend selector.",
          "enum": [
            "auto",
            "foldx",
            "esm1v",
            "biophysical"
          ],
          "title": "Stability Backend",
          "type": "string"
        },
        "run_alanine_scan": {
          "default": true,
          "description": "Whether to compute per-residue alanine scan scores.",
          "title": "Run Alanine Scan",
          "type": "boolean"
        },
        "foldx_binary": {
          "default": "foldx",
          "description": "Executable name or path for FoldX if installed.",
          "title": "Foldx Binary",
          "type": "string"
        },
        "esm_model_name": {
          "default": "facebook/esm1v_t33_650M_UR90S_1",
          "description": "ESM-1v model identifier for zero-shot variant scoring.",
          "title": "Esm Model Name",
          "type": "string"
        }
      },
      "title": "BiophysGuardConfig",
      "type": "object"
    },
    "ChargeMetrics": {
      "description": "Classical electrodynamics, coupled PROPKA-style titration, Agrawal SCM, and OPIG TAP charge metrics.",
      "properties": {
        "calculable": {
          "default": true,
          "title": "Calculable",
          "type": "boolean"
        },
        "status_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Reason"
        },
        "ph": {
          "title": "Ph",
          "type": "number"
        },
        "pka_model": {
          "default": "PROPKA3_coupled_desolvation_HB_Coulomb",
          "title": "Pka Model",
          "type": "string"
        },
        "reference_origin": {
          "default": "atomic_mass_weighted_center_of_mass",
          "title": "Reference Origin",
          "type": "string"
        },
        "center_of_mass_angstrom": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Of Mass Angstrom",
          "type": "array"
        },
        "is_origin_dependent_dipole": {
          "description": "True whenever abs(net_charge) > 1e-3 e; dipole is strictly standardized to the mass-weighted CoM.",
          "title": "Is Origin Dependent Dipole",
          "type": "boolean"
        },
        "net_charge": {
          "title": "Net Charge",
          "type": "number"
        },
        "net_charge_by_chain": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Net Charge By Chain",
          "type": "object"
        },
        "positive_charge": {
          "minimum": 0.0,
          "title": "Positive Charge",
          "type": "number"
        },
        "negative_charge": {
          "maximum": 0.0,
          "title": "Negative Charge",
          "type": "number"
        },
        "isoelectric_point": {
          "maximum": 14.0,
          "minimum": 0.0,
          "title": "Isoelectric Point",
          "type": "number"
        },
        "charge_density_per_1000a2": {
          "title": "Charge Density Per 1000A2",
          "type": "number"
        },
        "dipole_moment_debye": {
          "minimum": 0.0,
          "title": "Dipole Moment Debye",
          "type": "number"
        },
        "dipole_vector_debye": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dipole Vector Debye",
          "type": "array"
        },
        "charge_symmetry_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Charge Symmetry Score",
          "type": "number"
        },
        "hemispheric_charge_asymmetry": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hemispheric Charge Asymmetry",
          "type": "number"
        },
        "dipole_normalized_asymmetry": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dipole Normalized Asymmetry",
          "type": "number"
        },
        "interchain_sfvcsp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OPIG TAP Structural Fv Charge Symmetry Parameter (q_A * q_B) for multi-chain assemblies.",
          "title": "Interchain Sfvcsp"
        },
        "ppc_positive_patch": {
          "description": "OPIG-style positive surface charge patch score (PPC).",
          "minimum": 0.0,
          "title": "Ppc Positive Patch",
          "type": "number"
        },
        "pnc_negative_patch": {
          "description": "OPIG-style negative surface charge patch score (PNC).",
          "minimum": 0.0,
          "title": "Pnc Negative Patch",
          "type": "number"
        },
        "scm_method_note": {
          "default": "Agrawal_2016_exposed_sidechain_SASA_ge_10A2_10A_sphere (no APBS Poisson-Boltzmann continuum integral)",
          "title": "Scm Method Note",
          "type": "string"
        },
        "scm_pos_sum": {
          "description": "Sum of positive atomic SCM values across exposed residues.",
          "minimum": 0.0,
          "title": "Scm Pos Sum",
          "type": "number"
        },
        "scm_neg_sum": {
          "description": "Sum of negative atomic SCM values across exposed residues (viscosity predictor).",
          "maximum": 0.0,
          "title": "Scm Neg Sum",
          "type": "number"
        },
        "max_scm_positive": {
          "title": "Max Scm Positive",
          "type": "number"
        },
        "min_scm_negative": {
          "title": "Min Scm Negative",
          "type": "number"
        },
        "salt_bridge_count": {
          "minimum": 0,
          "title": "Salt Bridge Count",
          "type": "integer"
        },
        "ionizable_residue_count": {
          "minimum": 0,
          "title": "Ionizable Residue Count",
          "type": "integer"
        }
      },
      "required": [
        "ph",
        "center_of_mass_angstrom",
        "is_origin_dependent_dipole",
        "net_charge",
        "positive_charge",
        "negative_charge",
        "isoelectric_point",
        "charge_density_per_1000a2",
        "dipole_moment_debye",
        "dipole_vector_debye",
        "charge_symmetry_score",
        "hemispheric_charge_asymmetry",
        "dipole_normalized_asymmetry",
        "ppc_positive_patch",
        "pnc_negative_patch",
        "scm_pos_sum",
        "scm_neg_sum",
        "max_scm_positive",
        "min_scm_negative",
        "salt_bridge_count",
        "ionizable_residue_count"
      ],
      "title": "ChargeMetrics",
      "type": "object"
    },
    "DevelopabilityVerdict": {
      "description": "Traffic-light developability gating summary anchored to OPIG/Coventry standards.",
      "properties": {
        "status": {
          "enum": [
            "GREEN",
            "AMBER",
            "RED",
            "INVALID_BACKBONE_ONLY"
          ],
          "title": "Status",
          "type": "string"
        },
        "is_backbone_only": {
          "default": false,
          "title": "Is Backbone Only",
          "type": "boolean"
        },
        "sidechain_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sidechain Completeness",
          "type": "number"
        },
        "green_count": {
          "default": 0,
          "minimum": 0,
          "title": "Green Count",
          "type": "integer"
        },
        "amber_count": {
          "default": 0,
          "minimum": 0,
          "title": "Amber Count",
          "type": "integer"
        },
        "red_count": {
          "default": 0,
          "minimum": 0,
          "title": "Red Count",
          "type": "integer"
        },
        "ml_confidence_flag": {
          "anyOf": [
            {
              "enum": [
                "GREEN",
                "AMBER",
                "RED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ml Confidence Flag"
        },
        "low_confidence_residue_count": {
          "default": 0,
          "minimum": 0,
          "title": "Low Confidence Residue Count",
          "type": "integer"
        },
        "low_confidence_surface_residues": {
          "items": {
            "type": "string"
          },
          "title": "Low Confidence Surface Residues",
          "type": "array"
        },
        "gate_checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "title": "Gate Checks",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "sidechain_completeness"
      ],
      "title": "DevelopabilityVerdict",
      "type": "object"
    },
    "GateCheck": {
      "description": "Single OPIG-style empirically anchored developability gate check.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "reference_source": {
          "title": "Reference Source",
          "type": "string"
        },
        "green_range": {
          "title": "Green Range",
          "type": "string"
        },
        "amber_range": {
          "title": "Amber Range",
          "type": "string"
        },
        "red_range": {
          "title": "Red Range",
          "type": "string"
        },
        "flag": {
          "enum": [
            "GREEN",
            "AMBER",
            "RED",
            "INVALID_BACKBONE_ONLY"
          ],
          "title": "Flag",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "reference_source",
        "green_range",
        "amber_range",
        "red_range",
        "flag",
        "detail"
      ],
      "title": "GateCheck",
      "type": "object"
